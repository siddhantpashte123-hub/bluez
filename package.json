{
  "name": "premium-discord-bot",
  "version": "1.0.0",
  "description": "Feature-rich Discord bot (discord.js v14) - slash commands, 24/7 VC, UPI QR, invites, AFK, automation. Runs natively with PM2 (no Docker).",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "pm2": "pm2 start index.js --name DiscordBot",
    "check": "node --check index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@omkarbhosale/upiqr": "^3.0.0",
    "discord-audio-stream": "^1.2.19",
    "discord.js": "^14.28.1",
    "dotenv": "^16.4.7",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "ffmpeg-static": "^5.3.0"
  }
}
